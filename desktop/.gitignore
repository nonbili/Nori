bin/
# `go build` without -o drops the binary here.
desktop
# Generated by `make frontend`, and embedded by main.go. `go build` needs it to
# exist, so build the frontend before building the app.
frontend/dist/
# Downloaded by the release workflow for the NSIS installer to embed.
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# The root .gitignore excludes *.pem; this one is a public key, meant to ship.
!update-key.pem
