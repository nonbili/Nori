{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "paths": {
      "@/components/sheet/SettingsSheet": ["./components/SharedSettingsSheet.tsx"],
      "@/lib/open-bookmark": ["./lib/open-bookmark.ts"],
      "@/*": ["../*"],
      "nori/*": ["../*"],
      "nori-root/*": ["../*"]
    },
    "types": ["bun", "node", "nativewind/types"]
  }
}
