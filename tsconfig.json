{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "paths": {
      "@/*": ["./*"],
      // The extension and desktop shells import shared code under their own
      // aliases; mapping them here keeps a root-level tsc from reporting every
      // shared import as unresolved.
      "nori/*": ["./*"],
      "nori-root/*": ["./*"],
      "main/*": ["./desktop/src/main/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["desktop"]
}
